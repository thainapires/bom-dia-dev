# Copie este arquivo para ".env" e preencha com um Personal Access Token
# do GitLab (escopo "api"), gerado em: https://gitlab.com/-/user_settings/personal_access_tokens
GITLAB_TOKEN=

# API Key do Wakatime, gerada em: https://wakatime.com/settings/api-key
WAKATIME_API_KEY=

# API Key do OpenRouter (usada pra gerar o texto humano da aba "Daily"),
# gerada em: https://openrouter.ai/settings/keys
# Sem essa chave (ou se a chamada falhar), o texto cai pra um fallback
# heurístico mais simples — ver backend/src/standup.ts.
OPENROUTER_API_KEY=

# Opcional — modelo do OpenRouter a usar (default: um modelo gratuito, ver
# backend/src/standup.ts). Só precisa mexer se o modelo default sair da
# lista de gratuitos: https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=
